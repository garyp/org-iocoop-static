{
  "name": "org-iocoop-astro",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "predev": "bun run policies:sync",
    "dev": "astro dev",
    "prebuild": "bun run policies:sync",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "clean:cache": "rm -rf .astro node_modules/.astro node_modules/.vite",
    "clean": "bun run clean:cache && rm -rf dist",
    "dev:fresh": "bun run clean:cache && bun run policies:sync && astro dev",
    "policies:sync": "bun scripts/sync-policies.js",
    "policies:update": "git submodule update --remote vendor/policies && bun run policies:sync",
    "test": "bun test",
    "check:api": "bun scripts/check-api.js",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/mdi": "^1.2.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "astro-icon": "^1.2.0",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2"
  }
}
