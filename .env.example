# Copy to .env for local work. Astro and Bun load it automatically. These are build-time public
# variables: they end up in the pages, so never put a secret here.

# The django-iocoop form API the forms post to. A production build fails without it.
# For a local django-iocoop container (see that repository's README):
PUBLIC_API_URL=http://localhost:8000/members/api

# The public half of the member portal's reCAPTCHA v2 keys (the portal holds the secret and
# verifies every token). If it is empty the forms use Google's test key, which always passes the
# widget; the portal then accepts it only while it runs with Google's matching test secret.
PUBLIC_RECAPTCHA_SITE_KEY=
