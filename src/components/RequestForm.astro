---
// A VPS, colocation or membership form, rendered from src/data/request-forms.js. It posts to the
// form's endpoint on django-iocoop (src/data/api.js); see ContactForm.astro for the captcha and the
// shared submit script.
import { requestForms } from "../data/request-forms.js"
import Callout from "./mdx/Callout.astro"
import { joinUrl } from "../data/site.js"
import { apiUrl } from "../data/api.js"
import Captcha from "./Captcha.astro"

const { kind } = Astro.props
const form = requestForms[kind]
if (!form) throw new Error(`RequestForm: no request form named "${kind}"`)

// Fields come under headings in the order the definitions list them.
const sections = []
for (const field of form.fields) {
  const current = sections.at(-1)
  if (current?.title === field.section) current.fields.push(field)
  else sections.push({ title: field.section, fields: [field] })
}

const endpoint = apiUrl(form.endpoint ?? `request-${kind}`)

const controlId = (field) => `${kind}-${field.name}`

// The browser's version of the server's hostname check (HTML patterns are case sensitive).
const hostnamePattern =
  "(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+(?:[A-Za-z]{2,63}|xn--[A-Za-z0-9-]{1,59})"

function hintFor(field) {
  switch (field.type) {
    case "email":
      return "Please enter a valid email address."
    case "tel":
      return "Please enter a phone number."
    case "hostname":
      return "Please enter a fully qualified hostname, like myhost.example.com."
    case "sshkeys":
      return "Please paste your SSH public key."
    case "select":
      return "Please choose an option."
    case "number": {
      const limits = []
      if (field.min !== undefined) limits.push(`at least ${field.min}`)
      if (field.max !== undefined) limits.push(`at most ${field.max}`)
      if (field.lessThan !== undefined) limits.push(`less than ${field.lessThan}`)
      return limits.length > 0
        ? `Please enter a number: ${limits.join(", ")}.`
        : "Please enter a number."
    }
    default:
      return "Please fill this in."
  }
}

const conditionalAttributes = (field) => {
  const rule = field.showWhen
  if (!rule) return {}
  return {
    "data-show-when": "",
    "data-show-field": rule.field,
    ...("equals" in rule
      ? { "data-show-equals": rule.equals }
      : { "data-show-more-than": rule.moreThan }),
  }
}
---

{!form.available && (
  <Callout title={`${form.serviceName} isn't currently available`} type="warning">
    <p>
      We're at capacity right now. If you send this request, it will be added to our waiting list.
    </p>
  </Callout>
)}

<form
  id={`${kind}-request-form`}
  action={endpoint}
  method="post"
  data-enhance-form
  class="not-prose my-8 flex flex-col gap-8 rounded-box border border-base-300 bg-base-100 p-6 sm:p-8"
>
  {/* Tells the server the service is full, so it tags the email as a waiting-list request. */}
  {!form.available && <input type="hidden" name="waiting_list" value="1" />}

  {form.membersOnly !== false && (
    <p class="text-[15px]">
      Requests are for members. Not a member yet?{" "}
      <a href={joinUrl} class="link">
        Join the co-op
      </a>
      .
    </p>
  )}

  {sections.map((section) => (
    <section class="flex flex-col gap-5">
      <h3 class="text-sm font-bold tracking-[0.1em] text-accent uppercase">{section.title}</h3>
      <div class="grid gap-5 sm:grid-cols-2">
        {section.fields.map((field) => {
          const id = controlId(field)
          const conditional = Boolean(field.showWhen)
          const describedBy = [field.help || field.helpLinks ? `${id}-help` : null, `${id}-error`]
            .filter(Boolean)
            .join(" ")
          const common = {
            id,
            name: field.name,
            required: field.required,
            disabled: conditional,
            "aria-describedby": describedBy,
          }
          return (
            <div
              class:list={[field.half ? "" : "sm:col-span-2"]}
              hidden={conditional}
              {...conditionalAttributes(field)}
            >
              <fieldset class="fieldset">
                {field.type === "checkbox" ? (
                  <legend class="fieldset-legend text-[15px] font-medium text-base-content">
                    {field.label}
                    {field.required && <span class="text-error">*</span>}
                  </legend>
                ) : (
                  <label class="label text-[15px] font-medium text-base-content" for={id}>
                    {field.label}
                    {field.required && <span class="text-error">*</span>}
                  </label>
                )}

                {field.type === "checkbox" && (
                  <label class="flex cursor-pointer items-start gap-3 text-base">
                    <input {...common} type="checkbox" value="yes" class="checkbox mt-0.5" />
                    <span>{field.checkboxLabel}</span>
                  </label>
                )}

                {field.type === "select" && (
                  <select {...common} class="select w-full text-base">
                    {field.options.map((option) => (
                      <option value={option.value} selected={option.value === field.defaultValue}>
                        {option.label}
                      </option>
                    ))}
                  </select>
                )}

                {field.type === "number" && (
                  <label class:list={["input w-full", { validator: field.required }]}>
                    <input
                      {...common}
                      type="number"
                      inputmode={field.integer === false ? "decimal" : "numeric"}
                      min={field.min}
                      max={field.max}
                      step={field.integer === false ? "any" : "1"}
                      value={field.defaultValue}
                      data-less-than={field.lessThan}
                      class="grow text-base"
                    />
                    {field.unit && <span class="label text-base-content/75">{field.unit}</span>}
                  </label>
                )}

                {field.type === "textarea" && (
                  <textarea
                    {...common}
                    rows={field.rows ?? 4}
                    maxlength={field.maxlength ?? 2000}
                    placeholder={field.placeholder}
                    autocomplete={field.autocomplete}
                    class="textarea min-h-24 w-full text-base"
                  />
                )}

                {field.type === "sshkeys" && (
                  <textarea
                    {...common}
                    rows={field.rows ?? 4}
                    maxlength="5000"
                    placeholder="ssh-ed25519 AAAA… you@host"
                    autocomplete="off"
                    autocapitalize="none"
                    spellcheck="false"
                    class="textarea min-h-24 w-full font-mono text-sm"
                  />
                )}

                {["text", "email", "tel", "hostname"].includes(field.type) && (
                  <input
                    {...common}
                    type={field.type === "hostname" ? "text" : field.type}
                    maxlength={field.maxlength ?? 400}
                    placeholder={field.placeholder}
                    autocomplete={field.autocomplete ?? "off"}
                    pattern={field.type === "hostname" ? hostnamePattern : undefined}
                    autocapitalize={field.type === "hostname" ? "none" : undefined}
                    spellcheck={field.type === "hostname" ? "false" : undefined}
                    class:list={["input w-full text-base", { validator: field.required }]}
                  />
                )}

                {(field.help || field.helpLinks) && (
                  <p
                    id={`${id}-help`}
                    class="flex flex-wrap items-baseline gap-x-3 text-sm text-base-content/75"
                  >
                    {field.help && <span>{field.help}</span>}
                    {(field.helpLinks ?? []).map((link) => (
                      <a href={link.href} class="link" target="_blank" rel="noopener">
                        {link.label}
                      </a>
                    ))}
                  </p>
                )}

                {field.required &&
                  !["select", "textarea", "sshkeys", "checkbox"].includes(field.type) && (
                    <p class="validator-hint hidden">{hintFor(field)}</p>
                  )}
                <p
                  id={`${id}-error`}
                  data-field-error={field.name}
                  class="text-sm text-error"
                  hidden
                  aria-live="polite"
                ></p>
              </fieldset>
            </div>
          )
        })}
      </div>
    </section>
  ))}

  <!-- A trap for bots: invisible to people, tempting to scripts. Anything typed here is discarded. -->
  <div aria-hidden="true" data-pagefind-ignore class="absolute -left-[9999px]">
    <label>
      Leave this field empty
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <Captcha />

  <div data-status-success role="status" class="alert alert-success alert-soft hidden">
    <span>{form.successMessage}</span>
  </div>
  <div data-status-error role="alert" class="alert alert-error alert-soft hidden">
    <span data-error-text></span>
  </div>

  <div>
    <button type="submit" class="btn btn-primary btn-lg font-bold" data-submit>
      <span class="loading loading-spinner hidden" data-spinner></span>
      {form.submitLabel ?? "Send request"}
    </button>
  </div>

  <noscript>
    <p class="text-sm text-error">
      This form needs JavaScript to run its spam check. You can also reach us through the contact
      page.
    </p>
  </noscript>
</form>

<script>
  import { enhanceForm } from "../scripts/enhance-form.js"

  for (const form of document.querySelectorAll("[data-enhance-form]")) enhanceForm(form)
</script>
