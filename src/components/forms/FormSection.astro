---
// A headed group of fields in a two-column grid (fields with `half` share a row).
const { title } = Astro.props
---

<section class="flex flex-col gap-5">
  {title && <h3 class="text-sm font-bold tracking-[0.1em] text-accent uppercase">{title}</h3>}
  <div class="grid gap-5 sm:grid-cols-2">
    <slot />
  </div>
</section>
