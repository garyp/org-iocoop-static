---
// The frame every form shares: the <form> that posts to a django-iocoop resource, the honeypot, the
// captcha, the success and error alerts and the submit button. The fields go in the slot.
// src/scripts/enhance-form.js does the submitting.
//
// Props: kind (names the form: its id is `<kind>-request-form`), resource (the API resource, see
// src/data/api.js), submitLabel, successMessage, and optionally available (false shows a
// waiting-list warning and tells the API, which tags the email as a waiting-list request),
// serviceName (for that warning), and membersOnly (false drops the "Requests are for members" line).
import { apiUrl } from "../../data/api.js"
import { joinUrl } from "../../data/site.js"
import Callout from "../mdx/Callout.astro"
import Captcha from "../Captcha.astro"

const {
  kind,
  resource,
  submitLabel,
  successMessage,
  available = true,
  serviceName,
  membersOnly = true,
} = Astro.props
---

{!available && (
  <Callout title={`${serviceName} isn't currently available`} type="warning">
    <p>
      We're at capacity right now. If you send this request, it will be added to our waiting list.
    </p>
  </Callout>
)}

<form
  id={`${kind}-request-form`}
  action={apiUrl(resource)}
  method="post"
  data-enhance-form
  class="not-prose my-8 flex flex-col gap-8 rounded-box border border-base-300 bg-base-100 p-6 sm:p-8"
>
  {/* Tells the API the service is full, so it tags the email as a waiting-list request. */}
  {!available && <input type="hidden" name="waiting_list" value="1" />}

  {membersOnly && (
    <p class="text-[15px]">
      Requests are for members. Not a member yet?{" "}
      <a href={joinUrl} class="link">
        Join the co-op
      </a>
      .
    </p>
  )}

  <slot />

  <!-- A trap for bots: invisible to people, tempting to scripts. Anything typed here is discarded. -->
  <div aria-hidden="true" data-pagefind-ignore class="absolute -left-[9999px]">
    <label>
      Leave this field empty
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <Captcha />

  <div data-status-success role="status" class="alert alert-success alert-soft hidden">
    <span>{successMessage}</span>
  </div>
  <div data-status-error role="alert" class="alert alert-error alert-soft hidden">
    <span data-error-text></span>
  </div>

  <div>
    <button type="submit" class="btn btn-primary btn-lg font-bold" data-submit>
      <span class="loading loading-spinner hidden" data-spinner></span>
      {submitLabel}
    </button>
  </div>

  <noscript>
    <p class="text-sm text-error">
      This form needs JavaScript to run its spam check. You can also reach us by phone or on Matrix.
    </p>
  </noscript>
</form>

<script>
  import { enhanceForm } from "../../scripts/enhance-form.js"

  for (const form of document.querySelectorAll("[data-enhance-form]")) enhanceForm(form)
</script>
