---
import ServiceCards from "../mdx/ServiceCards.astro"
---

<section id="services" aria-labelledby="svc-h" class="border-y border-base-300 bg-base-200">
  <div class="container flex flex-col gap-12 py-14 sm:py-20 lg:py-24">
    <div class="flex flex-col gap-3">
      <p class="text-sm font-bold tracking-[0.1em] text-accent uppercase">Services</p>
      <h2 id="svc-h" class="text-[clamp(30px,6vw,40px)] leading-[1.1] font-bold tracking-tight">
        Run a virtual server, or bring your own hardware.
      </h2>
      <p class="max-w-[60ch] text-base-content/75">
        Both live at Hurricane Electric's FMT2 data center in Fremont, California.
      </p>
    </div>

    <ServiceCards />
  </div>
</section>
