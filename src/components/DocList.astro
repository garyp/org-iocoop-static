---
import { docHref } from "../lib/docs.js"

const { groups } = Astro.props
---

<div class="flex flex-col gap-12">
  {groups.map((group) => (
    <section class="flex flex-col gap-5">
      <h2 class="text-sm font-bold tracking-[0.1em] text-accent uppercase">{group.title}</h2>
      <ul class="grid gap-4 md:grid-cols-2">
        {group.items.map((entry) => (
          <li>
            <a
              href={docHref(entry.id)}
              class="flex h-full flex-col gap-1.5 rounded-box border border-base-300 bg-base-100 p-5 transition-colors hover:border-accent"
            >
              <span class="text-[19px] font-bold">{entry.data.title}</span>
              {entry.data.description && (
                <span class="text-[15px] text-base-content/75">{entry.data.description}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
