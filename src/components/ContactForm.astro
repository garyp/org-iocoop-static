---
// The contact form. It posts to the Pages Function in functions/api/contact.js, which verifies the
// Turnstile token and sends the email. Cloudflare publishes a site key that always passes, used
// here when PUBLIC_TURNSTILE_SITE_KEY isn't set; real deployments must set it (see README).
import { contactPurposes, defaultPurpose } from "../data/contact-purposes.js"

const testSiteKey = "1x00000000000000000000AA"
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || testSiteKey
if (import.meta.env.PROD && siteKey === testSiteKey) {
  console.warn("ContactForm: PUBLIC_TURNSTILE_SITE_KEY is not set; using Cloudflare's test key.")
}
---

<form
  id="contact-form"
  data-enhance-form
  action="/api/contact"
  method="post"
  class="flex flex-col gap-5 rounded-box border border-base-300 bg-base-100 p-6 sm:p-8"
>
  <div class="grid gap-5 sm:grid-cols-2">
    <fieldset class="fieldset">
      <label class="label text-[15px] font-medium text-base-content" for="contact-name">
        Your name <span class="text-error">*</span>
      </label>
      <input
        id="contact-name"
        name="name"
        type="text"
        class="input validator w-full text-base"
        required
        maxlength="400"
        autocomplete="name"
      />
      <p class="validator-hint hidden">Please enter your name.</p>
      <p data-field-error="name" class="text-sm text-error" hidden aria-live="polite"></p>
    </fieldset>

    <fieldset class="fieldset">
      <label class="label text-[15px] font-medium text-base-content" for="contact-email">
        Your email <span class="text-error">*</span>
      </label>
      <input
        id="contact-email"
        name="email"
        type="email"
        class="input validator w-full text-base"
        required
        maxlength="400"
        autocomplete="email"
      />
      <p class="validator-hint hidden">Please enter a valid email address.</p>
      <p data-field-error="email" class="text-sm text-error" hidden aria-live="polite"></p>
    </fieldset>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <fieldset class="fieldset">
      <label class="label text-[15px] font-medium text-base-content" for="contact-purpose">
        Purpose <span class="text-error">*</span>
      </label>
      <select id="contact-purpose" name="purpose" class="select w-full text-base" required>
        {contactPurposes.map((purpose) => (
          <option value={purpose.value} selected={purpose.value === defaultPurpose}>
            {purpose.label}
          </option>
        ))}
      </select>
      <p data-field-error="purpose" class="text-sm text-error" hidden aria-live="polite"></p>
    </fieldset>

    <fieldset class="fieldset">
      <label class="label text-[15px] font-medium text-base-content" for="contact-subject">
        Subject
      </label>
      <input
        id="contact-subject"
        name="subject"
        type="text"
        class="input w-full text-base"
        maxlength="400"
        autocomplete="off"
      />
      <p data-field-error="subject" class="text-sm text-error" hidden aria-live="polite"></p>
    </fieldset>
  </div>

  <fieldset class="fieldset">
    <label class="label text-[15px] font-medium text-base-content" for="contact-message">
      Your message
    </label>
    <textarea
      id="contact-message"
      name="message"
      class="textarea min-h-40 w-full text-base"
      maxlength="2000"
      rows="7"
    ></textarea>
    <p data-field-error="message" class="text-sm text-error" hidden aria-live="polite"></p>
    <p class="label justify-end tabular-nums text-sm text-base-content/75" aria-hidden="true">
      <span>
        <span data-count-for="message">0</span>/2000
      </span>
    </p>
  </fieldset>

  <!-- A trap for bots: invisible to people, tempting to scripts. Anything typed here is discarded. -->
  <div aria-hidden="true" data-pagefind-ignore class="absolute -left-[9999px]">
    <label>
      Leave this field empty
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div
    class="cf-turnstile"
    data-sitekey={siteKey}
    data-theme="auto"
    data-action="contact"
    data-appearance="interaction-only"
  ></div>

  <div data-status-success role="status" class="alert alert-success alert-soft hidden">
    <span>Thanks, your message is on its way. We'll reply as soon as someone can.</span>
  </div>
  <div data-status-error role="alert" class="alert alert-error alert-soft hidden">
    <span data-error-text></span>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="btn btn-primary btn-lg font-bold" data-submit>
      <span class="loading loading-spinner hidden" data-spinner></span>
      Send message
    </button>
  </div>

  <noscript>
    <p class="text-sm text-error">
      This form needs JavaScript to run its spam check. You can also reach us by phone or on Matrix.
    </p>
  </noscript>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { enhanceForm } from "../scripts/enhance-form.js"

  const form = document.getElementById("contact-form")
  enhanceForm(form)

  // A link like /contact/?purpose=billing preselects that choice. Unknown values are ignored.
  const purposeSelect = form?.querySelector("#contact-purpose")
  const requestedPurpose = new URLSearchParams(location.search).get("purpose")
  if (
    purposeSelect &&
    requestedPurpose &&
    [...purposeSelect.options].some((option) => option.value === requestedPurpose)
  ) {
    purposeSelect.value = requestedPurpose
  }
</script>
