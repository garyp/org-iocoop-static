---
import BaseLayout from "../../../layouts/BaseLayout.astro"
import PageHeader from "../../../components/PageHeader.astro"
import SearchButton from "../../../components/SearchButton.astro"
import DocList from "../../../components/DocList.astro"
import { buildTree, getSectionDocs, groupDocs, sections } from "../../../lib/docs.js"

const info = sections.members
const topLevel = buildTree(await getSectionDocs("members")).map((node) => node.entry)
const groups = groupDocs(topLevel)
---

<BaseLayout
  title={`${info.label} · IO Coöperative`}
  description="Information useful to IO Coöperative members."
  excludeFromSearch
  searchScope="docs"
>
  <PageHeader
    eyebrow="Docs"
    title={info.label}
    description="Here you’ll find information useful to IO Coöperative members."
  >
    <SearchButton variant="field" scope="docs" label="Search the docs" class="mt-2 max-w-lg" />
  </PageHeader>

  <div class="container flex flex-col gap-12 pt-10 pb-16 sm:pt-14 sm:pb-24">
    <DocList groups={groups} />

    <aside class="max-w-[70ch] rounded-box border border-base-300 bg-base-200 p-5 text-[16px]">
      <p class="font-bold">Members-only wiki</p>
      <p class="mt-1 text-base-content/75">
        More documentation lives in the{" "}
        <a href="https://github.com/iocoop/members/wiki" class="link">
          members-only wiki
        </a>
        . If you’re a member and would like access, open a{" "}
        <a href="/support/" class="link">
          support request
        </a>{" "}
        and give your GitHub username.
      </p>
    </aside>
  </div>
</BaseLayout>
